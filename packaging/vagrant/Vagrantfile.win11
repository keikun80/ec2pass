# -*- mode: ruby -*-
# vi: set ft=ruby :
# Vagrantfile for InhausLab ec2pass - Windows 11 Enterprise / Pro VirtualBox Environment

Vagrant.require_version ">= 2.2.0"

Vagrant.configure("2") do |config|
  config.vm.box = ENV["VAGRANT_WIN11_BOX"] || "gusztavvargadr/windows-11"
  config.vm.hostname = "ec2pass-win11"
  config.vm.communicator = "winrm"
  config.vm.boot_timeout = (ENV["VM_BOOT_TIMEOUT"] || 900).to_i

  # Disable default SMB/NFS share to avoid Windows credential prompts
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # VirtualBox Provider Settings for Windows 11
  config.vm.provider "virtualbox" do |vb|
    vb.name = "ec2pass-win11-dev"
    vb.cpus = (ENV["VM_CPUS"] || 4).to_i
    vb.memory = (ENV["VM_MEMORY"] || 6144).to_i

    # Windows 11 Hardware Requirements Emulation
    vb.customize ["modifyvm", :id, "--firmware", "efi"]
    vb.customize ["modifyvm", :id, "--tpm-type", "2.0"]
    vb.customize ["modifyvm", :id, "--nested-hw-virt", "on"]
    vb.customize ["modifyvm", :id, "--vram", "128"]
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vboxvmsvga"]
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
  end

  # Automated Environment Provisioning
  config.vm.provision "shell",
    path: File.expand_path("../provision_win11.ps1", __FILE__)
end
